rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getRole(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path) ? get(path).data.role : 'GUEST';
    }

    function isAdmin() {
      return isSignedIn() && getRole(request.auth.uid) == 'ADMIN';
    }

    function getUserData(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return get(path).data;
    }

    function isDoctor() {
      return isSignedIn() && getRole(request.auth.uid) == 'DOCTOR';
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Helpers ---

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['PATIENT', 'DOCTOR_PENDING', 'DOCTOR', 'ADMIN'] &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('institutionId' in data) || data.institutionId == null || data.institutionId == "" || isValidId(data.institutionId)) &&
             (!('age' in data) || (data.age is int && data.age > 0 && data.age < 150)) &&
             (!('sex' in data) || (data.sex in ['male', 'female', 'other'])) &&
             (!('height' in data) || data.height == null || (data.height is string && data.height.size() <= 20)) &&
             (!('weight' in data) || data.weight == null || (data.weight is string && data.weight.size() <= 20)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 500)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             (!('profileCompleted' in data) || data.profileCompleted is bool) &&
             (!('medicalLicenseId' in data) || (data.medicalLicenseId is string && data.medicalLicenseId.size() <= 50)) &&
             (!('specialization' in data) || (data.specialization is string && data.specialization.size() <= 100)) &&
             (!('requestedInstitutionName' in data) || (data.requestedInstitutionName is string && data.requestedInstitutionName.size() <= 200));
    }

    function isValidInstitution(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.address is string && data.address.size() <= 300;
    }

    function isValidPrescription(data) {
      return isValidId(data.patientId) &&
             isValidId(data.doctorId) &&
             isValidId(data.institutionId) &&
             data.diagnosis is string && data.diagnosis.size() <= 500 &&
             data.medicines is list && data.medicines.size() <= 50;
    }

    function isValidQueue(data) {
      return isValidId(data.patientId) &&
             isValidId(data.institutionId) &&
             data.status in ['WAITING', 'IN_CONSULTATION', 'COMPLETED', 'CANCELLED'];
    }

    // --- Rules ---
    
    match /system/connection-test {
      allow read: if true;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (
        isOwner(userId) ||
        isAdmin() ||
        (isDoctor() && resource.data.role == 'PATIENT' && resource.data.institutionId == getUserData(request.auth.uid).institutionId) ||
        (!isDoctor() && resource.data.role == 'DOCTOR')
      );
      allow list: if isSignedIn() && (
        isOwner(userId) ||
        isAdmin() ||
        (isDoctor() && resource.data.role == 'PATIENT' && resource.data.institutionId == getUserData(request.auth.uid).institutionId) ||
        (!isDoctor() && resource.data.role == 'DOCTOR')
      );
      allow create: if isOwner(userId) && isValidUser(incoming()) && 
                      (incoming().role in ['PATIENT', 'ADMIN']) && // Admin allowed for bootstrap
                      incoming().keys().hasAll(['uid', 'email', 'role', 'createdAt']);
      allow update: if isSignedIn() && (
                      (isOwner(userId) && isValidUser(incoming()) && (
                        // Role shift to pending (Apply as Doctor)
                        (incoming().role == 'DOCTOR_PENDING' && existing().role == 'PATIENT' && 
                         incoming().diff(existing()).affectedKeys().hasOnly(['role', 'medicalLicenseId', 'specialization', 'requestedInstitutionName'])) ||
                        // Full Profile Update (Name, Bio, Health Stats)
                        (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'institutionId', 'age', 'sex', 'height', 'weight', 'profileCompleted', 'address', 'photoURL']))
                      )) || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'institutionId']))
                    );
    }

    match /institutions/{instId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isValidInstitution(incoming());
      allow delete: if isAdmin();
    }

    match /prescriptions/{pid} {
      allow list: if isSignedIn() && (
        resource.data.patientId == request.auth.uid || 
        isDoctor() ||
        isAdmin()
      );
      allow get: if isSignedIn() && isValidId(pid) && (
        resource.data.patientId == request.auth.uid || 
        isDoctor() ||
        isAdmin()
      );
      allow create: if isDoctor() && isValidPrescription(incoming()) &&
                    incoming().doctorId == request.auth.uid;
      allow update: if isDoctor() && isValidId(pid) && isValidPrescription(incoming()) &&
                    existing().doctorId == request.auth.uid &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['diagnosis', 'medicines', 'notes', 'version', 'updatedAt']);
    }

    match /queues/{qid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(qid) && isValidQueue(incoming()) && incoming().patientId == request.auth.uid;
      allow update: if (isDoctor() || (isOwner(resource.data.patientId) && incoming().status == 'CANCELLED' && incoming().diff(existing()).affectedKeys().hasOnly(['status']))) && isValidId(qid);
      allow delete: if (isDoctor() || isOwner(resource.data.patientId)) && isValidId(qid);
    }
  }
}
